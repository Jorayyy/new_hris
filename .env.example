APP_NAME="HRIS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en_PH
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

APP_TIMEZONE=Asia/Manila

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local dev defaults to SQLite (zero setup). For production/hosting use MySQL:
# set DB_CONNECTION=mysql and fill DB_HOST/DB_PORT/DB_DATABASE/DB_USERNAME/DB_PASSWORD.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hris
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Queue driver for notifications/emails — a running `php artisan queue:work` is required (see below).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Production mail: set MAIL_MAILER=smtp and fill MAIL_HOST/MAIL_PORT/MAIL_USERNAME/
# MAIL_PASSWORD and MAIL_FROM_ADDRESS. Password-reset links and employee decision
# emails are delivered through this transport.

# ---- Production setup (run once per deploy) ----
# 1. php artisan migrate --force
# 2. php artisan storage:link              (employee 201-file uploads live on the public disk)
# 3. php artisan config:cache && php artisan route:cache && php artisan view:cache
# 4. Scheduler: add to crontab (needed for attendance:mark-absent at 23:30):
#    * * * * * cd /path-to-app && php artisan schedule:run >> /dev/null 2>&1
# 5. Queue worker: notifications and emails run on the queue, so a worker MUST run:
#    php artisan queue:work --tries=3 --timeout=120
#    (keep it alive with Supervisor or a systemd unit; without it, no notification is delivered)
# 6. Backups: dump the database nightly (mysqldump) and archive the storage/app/public
#    directory; keep off-server copies. APP_KEY must be backed up too — losing it loses encrypted data.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
